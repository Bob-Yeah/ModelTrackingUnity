//// 主核函数
[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    int stride = 1;
    if (id.x >= 2125) 
    {
        return;
    }
    int anchor_x = 0;
    int anchor_y = 0;
    if (id.x < 1600)
    {
        stride = 8;
        anchor_x = id.x % 40;
        anchor_y = id.x / 40;
        
    }
    else if (id.x < 2000)
    {
        anchor_x = (id.x - 1600) % 20;
        anchor_y = (id.x - 1600) / 20;
        stride = 16;
    }
    else if (id.x < 2100)
    {
        stride = 32;
        anchor_x = (id.x - 2000) % 10;
        anchor_y = (id.x - 2000) / 10;
    }
    else
    {
        stride = 64;
        anchor_x = (id.x - 2100) % 5;
        anchor_y = (id.x - 2100) / 5;
    }
    _result[id.x] = _input[id.x * 33];
    //_result[id.x * 6 + 1] = _input[id.x * 33 + 1];
    //_result[id.x * 6 + 2] = _input[id.x * 33 + 2];
