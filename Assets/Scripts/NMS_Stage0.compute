#pragma kernel InitializeSortData
#pragma kernel BitonicSortStep
#pragma kernel WriteSortedOutput

StructuredBuffer<float> inputBuffer;
RWStructuredBuffer<float> outputBuffer;
RWStructuredBuffer<float2> scoreIndexPairs;

int numDetections; //2125
int stride;        //6
int PADDED_COUNT; //4096
uint stage_idx;         // current stage_idx k (1 to 12)
uint pass_idx;          // current pass_idx j (0 to k-1)

[numthreads(256, 1, 1)]
void InitializeSortData(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= PADDED_COUNT) return;

    if (idx < numDetections)
    {
        float score = inputBuffer[idx * stride + 4];
        scoreIndexPairs[idx] = float2(score, (float)idx);
    }
    else
    {
        scoreIndexPairs[idx] = float2(-1.0, (float)idx);
    }
}

[numthreads(64, 1, 1)]
void BitonicSortStep(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= PADDED_COUNT) return;

    uint boxSize = 1u << stage_idx;                  // 2^stage_idx
    uint dist = 1u << (stage_idx - 1 - pass_idx);         // 2^(stage_idx-1-pass_idx)

    uint boxStart = (i / boxSize) * boxSize;
    uint idxInBox = i % boxSize;

    // Only first half of the box participates in compare
    if (idxInBox >= dist) return;

    uint partner = i + dist;
    if (partner >= PADDED_COUNT) return;

    float2 a = scoreIndexPairs[i];
    float2 b = scoreIndexPairs[partner];

    // Descending order: larger score should come first
    // In bitonic sort for descending, we want a >= b in the first half
    if (a.x < b.x)
    {
        // Swap
        scoreIndexPairs[i] = b;
        scoreIndexPairs[partner] = a;
    }
}

[numthreads(256, 1, 1)]
void WriteSortedOutput(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx < numDetections)
    {
        uint originalIndex = (uint)scoreIndexPairs[idx].y;
        if (originalIndex != 0xFFFFFFFF)
        {
            for (int i = 0; i < stride; i++)
            {
                outputBuffer[idx * stride + i] = inputBuffer[originalIndex * stride + i];
            }
        }
    }
}